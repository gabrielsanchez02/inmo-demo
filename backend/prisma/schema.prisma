// This is your Prisma schema file,
//
// Learn more about it at https://prismlang.github.io/prisma-docs/main/core/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id        Int      @id @default(autoincrement())
  title     String
  description String
  price     Int
  type      String   // "house", "apartment", "cottage", "land"
  operation String // "sale", "rent"
  province  String
  city      String
  bedrooms  Int
  bathrooms Int
  area      Int
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String
  propertyId  Int?
  property  Property?
  status    String @default("new") // "new", "contacted", "visit_scheduled", "discarded"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}