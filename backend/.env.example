# Variables de entorno para el backend
# Esta es una plantilla. Cree un archivo .env a partir de esta para usar en producción

# URL de conexión a la base de datos
DATABASE_URL=sqlite:./db.sqlite

# Puerto del servidor
PORT=3000

# Origen permitido para CORS (dejar en blanco para permitir todos)
CORS_ORIGIN=*

# Clave secreta para JWT
JWT_SECRET=your-super-secret-jwt-key

# Origen de la API del frontend (para configuración de CORS)
FRONTEND_URL=https://your-frontend-url.com

# Configuración de Prisma
PRISMA_SCHEMA_PATH=./prisma/schema.prisma